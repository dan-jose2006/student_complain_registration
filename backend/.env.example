# CampusCare Environment Variables
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection String (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuscare?schema=public"

# Authentication Secret (Keep secure in production)
JWT_SECRET="campuscare-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Groq AI API Key (Required for AI Complaint Analysis & Admin Insights)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_demo_placeholder_or_real_key"
GROQ_MODEL="llama-3.3-70b-versatile"
